<script>
var element =  document.getElementById('coursedetails');
if (typeof(element) != 'undefined' && element != null)
{
        document.getElementById("aboutme").removeAttribute("checked");
        document.getElementById("coursedetails").setAttribute("checked", "checked");
}

//Удалить поиск по логину со страницы Забыли пароль
if (window.location.pathname == '/login/forgot_password.php') document.getElementById('id_searchbyusername').remove();

//Надпись красным "После выбора категории нажмите кнопку Применить фильтры!" при добавлении в тест случайных вопросов.
var target = document.querySelector('#page-mod-quiz-edit');
var setwarning = false;
if (window.location.toString().includes('/mod/quiz/edit.php?cmid='))
{
const testobserver = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
		tc = document.getElementsByClassName('tab-content');
		if (document.getElementsByClassName('modal moodle-has-zindex show').length > 0)
		{
			if (tc[tc.length-1].getElementsByClassName('ihatemoodleandallthehackihavetoimplement').length < 1) {
				tc[tc.length-1].insertAdjacentHTML('afterbegin', '<p style="color:red" class="ihatemoodleandallthehackihavetoimplement"><b>После выбора категории нажмите кнопку &laquo;Применить фильтры&raquo;!</b></p>');
			}
		}
    });
});
testobserver.observe(target, {
childList: true,
});
}

//Скрыть кнопку Мои курсы (ведет туда же, куда и Личный кабинет)
document.querySelector('[data-key="mycourses"]').remove();

</script>
